# Server-only. Never prefix these keys with NEXT_PUBLIC_.
# Email delivery adapter currently supports Resend; confirm existing provider before launch.
RESEND_API_KEY=
# Use an address on a domain verified by your email provider, not a Gmail sender.
ENQUIRY_FROM=
# Production origin for enquiry requests. Canonical SEO stays on vagarthayoga.com.
SITE_URL=https://vagarthayoga.com
# For local production smoke tests only. Leave false on any public deployment.
ALLOW_LOCAL_ENQUIRY=false
# VERCEL_URL / DEPLOY_PRIME_URL are read automatically when supplied by the host.
# The recipient is fixed server-side to vagarthayoga@gmail.com.
